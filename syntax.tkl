use tklib::io;
use tklib::string;
inc "file.tkl"

fn int main() {
    int x = 22;
    int u = x;
    ptr int a = &u;         //int* a = &u;
    int b = &x;
    str s = "hello";
    string i = "qwert";
    println("hi, this syntax of TK-language");
    println(a, &a, ".");
    println("output: 22[address in memory] ");
    input.get();
    return 0;
}


//ODS — Object Data Structures
//ODS the alternative of OOP
objs player;
//also object can have parameters
objs Player(string name, string status, fn int());

player entity {
    string name;
    string status
}

Player Myplayer(string name, string status, fn int damage(int Damage, int objecthp)) {
    name = "TKplayer";
    status = "progger";
    fn int damage(int Damage, int object) {
        if(objecthp - Damage < 0) {
            objecthp = 0;
        }
        return objecthp - Damage;
    }
}

//also TK language been have memorz profiles
//if memory profile the safe, program with memory leaks, use after free and others shit dont compile
//else if memory profile the unsafe, prgram with memory leaks and other sucessefuly compile
//syntax:
#[mem]unsafe
#[mem]safe


fn int progWithMemoryLeak() {
    new int x = 2;
    println(x);
    return x;
    //if #[mem]unsafe program compile 
    //else if #[mem]safe program doesn't compile

}